{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Orchestrator",
  "version": "0.5.0",
  "identifier": "dev.orchestrator.desktop",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Orchestrator",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 10, "y": 18 },
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'self' blob:; frame-src 'self' blob:",
      "assetProtocol": {
        "enable": false
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NDAzQzkzOEY1Q0QwRTQKUldUazBGeVBrenhBUk5DN05ySFAwSnk2TS8rK3VnTHpWYnhlSE1hZkd2bVQrRU1mTTBKdWpmQloK",
      "endpoints": [
        "https://github.com/rynitepsd-tech/the-orchestrator/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": {
      "../../../resources/engine": "engine"
    },
    "copyright": "Copyright \u00a9 2026 The Orchestrator contributors. MIT licensed.",
    "category": "DeveloperTool",
    "shortDescription": "Desktop harness for OhMyPi",
    "longDescription": "An unofficial native macOS desktop interface for the OhMyPi (OMP) coding agent. Run several agent sessions at once, choose models and advisors per session, and see exactly which models consume your usage.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    }
  }
}
